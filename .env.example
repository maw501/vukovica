# ---------------------------------------------------------------------------
# Client env — copy to `.env.local` (git-ignored). Everything here is bundled
# into the web build, so only ever put public (anon) values in this file.
# ---------------------------------------------------------------------------

# Supabase project URL. Local dev default is http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_URL=
# Supabase anon/publishable key (safe to ship; RLS is what protects the data).
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Sign-up gate. The sign-in screen offers account creation only when this is
# exactly "true". This is a single-user instance: set it to true once, register,
# then remove it so the deployed bundle has no sign-up path at all.
EXPO_PUBLIC_ALLOW_SIGNUP=

# ---------------------------------------------------------------------------
# Seeding (repo-root `.env.local`) — read by `npm run db:seed`, which runs
# `node --env-file=.env.local scripts/seed.mjs`. These are server-side only:
# the service-role key bypasses RLS, so it must never reach the app bundle
# (note the missing EXPO_PUBLIC_ prefix — that is what keeps it out).
# Local values come from `npx supabase status` (API URL and service_role key).
# ---------------------------------------------------------------------------

# Supabase project URL. Local dev default is http://127.0.0.1:54321
SUPABASE_URL=
# Service-role key. Full access to the database — keep it out of git.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Edge Function secrets — these belong in `supabase/.env.local` (git-ignored),
# NOT in .env.local. They are passed via:
#   supabase functions serve --env-file supabase/.env.local
# and set in production with `supabase secrets set`.
# ---------------------------------------------------------------------------

# Which AI provider the `tutor` / `generate` / `tts` functions use.
# AI_PROVIDER=openai|anthropic
AI_PROVIDER=anthropic

# Required for AI_PROVIDER=anthropic.
ANTHROPIC_API_KEY=
# Required for AI_PROVIDER=openai. ALSO required for text-to-speech regardless
# of provider — `tts` always calls OpenAI. Without it `tts` returns
# {"url": null} for anything not already cached, and the client hides audio.
OPENAI_API_KEY=

# Optional model overrides. Defaults per provider:
#   anthropic -> AI_CHAT_MODEL=claude-sonnet-5, AI_FAST_MODEL=claude-haiku-4-5
#   openai    -> AI_CHAT_MODEL=gpt-4o,          AI_FAST_MODEL=gpt-4o-mini
# AI_CHAT_MODEL=
# AI_FAST_MODEL=

# Optional base-URL overrides, for pointing at a gateway or a local mock.
# Unset = the provider's own API. OPENAI_BASE_URL also redirects `tts`.
# OPENAI_BASE_URL=
# ANTHROPIC_BASE_URL=

# Optional text-to-speech overrides. Defaults: gpt-4o-mini-tts / alloy.
# TTS_MODEL=
# TTS_VOICE=

# Base URL used to build public audio URLs handed back by `tts`. Inside the
# Edge runtime SUPABASE_URL points at the internal gateway (http://kong:8000
# locally), which a browser or phone cannot reach. Set this locally to
# http://127.0.0.1:54321; in production it is unnecessary (SUPABASE_URL is
# already the public URL).
# PUBLIC_SUPABASE_URL=
