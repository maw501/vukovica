{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ],
  "exclude": [
    "node_modules",
    "supabase/functions/**"
  ],
  // Edge Functions are Deno code and are excluded above, but these are
  // runtime-neutral and covered by vitest, so they stay under `tsc --noEmit`.
  // (`files` entries survive `exclude`; `include` entries do not.)
  "files": [
    "supabase/functions/_shared/prompts.ts",
    "supabase/functions/_shared/usage.ts",
    "supabase/functions/_shared/cyrillic.ts",
    "supabase/functions/_shared/__tests__/prompts.test.ts",
    "supabase/functions/_shared/__tests__/usage.test.ts",
    "supabase/functions/_shared/__tests__/cyrillic.test.ts"
  ]
}
