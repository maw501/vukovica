{
  "expo": {
    "name": "Vukovica",
    "slug": "vukovica",
    "description": "Serbian for the family: Cyrillic-first flashcards, a script trainer and stories to read.",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "vukovica",
    "userInterfaceStyle": "light",
    "primaryColor": "#17427A",
    "backgroundColor": "#FAF8F5",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#17427A",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png",
      "name": "Vukovica",
      "shortName": "Vukovica",
      "lang": "en-GB",
      "description": "Serbian for the family: Cyrillic-first flashcards, a script trainer and stories to read.",
      "display": "standalone",
      "orientation": "portrait",
      "startUrl": "/",
      "scope": "/",
      "themeColor": "#17427A",
      "backgroundColor": "#FAF8F5"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FAF8F5"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
